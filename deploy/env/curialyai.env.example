# /etc/curialyai.env: environment for curialyai.service (owner root:root, mode 600).
# Every value marked <secret> must be generated or copied from the provider's dashboard;
# never commit the real file. Non-secret defaults are the values production uses.

# ---- Server ----
PUBLIC_BASE_URL=https://curialy.tech
# NODE_ENV, PORT and HOST are set in the systemd unit (production / 3000 / 127.0.0.1).

# ---- Operator login (single admin) ----
ADMIN_PASSWORD_HASH=<secret>            # node scripts/set-admin-password.mjs  ->  scrypt:...
SESSION_SECRET=<secret>                 # 48+ random characters: openssl rand -base64 48

# ---- Data: Tiger Cloud Postgres (all tasks, events, conversations, metadata) ----
TIGER_DATABASE_URL=<secret>             # postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require

# ---- Snowflake (media stage and SQL AI_COMPLETE models) ----
SNOWFLAKE_ACCOUNT=<account-identifier>  # e.g. orgname-accountname
SNOWFLAKE_USER=CORTEX_CLI_USER
SNOWFLAKE_ROLE=CORTEX_CLI_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_MEDIA_STAGE=@CURIALY_DB.PUBLIC.USER_MEDIA_STAGE
SNOWFLAKE_PAT=<secret>                  # programmatic access token for SNOWFLAKE_USER

# ---- Model routes ----
# Cortex Messages + chat/completions + inference go through the local bridge, which holds its
# own copy of the PAT (/etc/snowflake-proxy.env).
CORTEX_BRIDGE_URL=http://127.0.0.1:8082
RELAY_API_URL=https://relaystation.world
RELAY_API_KEY=<secret>                  # Gemini 3.8 / 2.5 Flash and the backup Claude routes
PAPER_API_URL=https://api.paperinstruments.com/v1
PAPER_API_KEY=<secret>                  # Ultramarine 1.0 Flash
PAPER_INSTRUMENTS_API_KEY=<secret>      # legacy alias of PAPER_API_KEY (same value)

# ---- Research Agent (delegate_research tool, Auto for browsing requests) ----
MANUS_AGENT_API_URL=https://api.manus.ai
MANUS_AGENT_API_KEY=<secret>
MANUS_AGENT_PROFILE=lite
MANUS_API_URL=https://forge.manus.ai    # legacy template integration
MANUS_API_KEY=<secret>

# ---- Live browser and visual testing ----
BROWSERBASE_API_KEY=<secret>
BROWSERBASE_PROJECT_ID=<project-id>

# ---- Cloud deploy previews ----
RENDER_API_KEY=<secret>
RENDER_OWNER_ID=<owner-id>              # tea-...
PREVIEW_TTL_MINUTES=120
# PREVIEW_REPO_PRIVATE=true             # default: preview repos are private

# ---- GitHub OAuth (scopes read:user, user:email, repo) ----
GITHUB_CLIENT_ID=<client-id>
GITHUB_CLIENT_SECRET=<secret>
GITHUB_TOKEN_KEY=<secret>               # 32 random bytes, base64: openssl rand -base64 32 (encrypts stored tokens)

# ---- Fine-tuning and speech (configured, optional) ----
TINKER_API_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
TINKER_API_KEY=<secret>
DEEPGRAM_API_KEY=<secret>
DEEPGRAM_PROJECT_ID=<project-id>

# ---- Agent sandbox ----
AGENT_WORKSPACE_ROOT=/srv/curialy-workspaces
AGENT_WORKSPACE_IDLE_MINUTES=60         # idle workspaces are snapshotted to Tiger and removed
# AGENT_SANDBOX_USER=curialy-agent      # default
# AGENT_SANDBOX=none                    # local development only: runs commands as the app user
