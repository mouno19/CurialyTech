# /etc/snowflake-proxy.env: environment for snowflake-proxy.service (owner root:root, mode 600).
# The bridge is the only process that sends the PAT to Cortex REST endpoints.
SNOWFLAKE_PAT=<secret>
SNOWFLAKE_HOST=<account>.ap-southeast-7.aws.snowflakecomputing.com
# With ~/snowflake-proxy/pool.json (see deploy/snowflake-proxy/pool.example.json) the pool's accounts are
# used instead, and the bridge rewrites this file with the active one when it rotates.
# PORT comes from the unit (8082).
